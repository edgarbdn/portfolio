---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    const proyectos = await getCollection('proyectos');
    return proyectos.map(proyecto => ({
        params: { id: proyecto.id },
        props: { proyecto },
    }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
---

<Layout>
    <section class="w-full min-h-screen flex flex-col items-center px-6 pt-40 pb-32">
        <div class="w-full max-w-5xl flex flex-col gap-12">

            <!-- Volver -->
            <a href="/" class="btn-volver">
                <svg class="flecha-volver" viewBox="0 0 80 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M70 20 C50 18, 25 16, 8 20" stroke="#e63946" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                    <path d="M8 20 L18 13 M8 20 L16 28" stroke="#e63946" stroke-width="2.5" stroke-linecap="round" fill="none"/>
                </svg>
                <span class="volver-texto">
                    volver atrás
                    <svg class="circulo" viewBox="0 0 130 70" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10 35 C8 12, 35 2, 65 3 C95 4, 122 14, 121 33 C120 52, 94 60, 63 60 C32 60, 7 50, 8 35" stroke="#e63946" stroke-width="2" stroke-linecap="round" fill="none"/>
                        <path d="M7 38 C4 13, 32 0, 65 1 C98 2, 126 13, 125 35 C124 57, 96 67, 63 67 C30 67, 5 55, 6 38" stroke="#e63946" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.6"/>
                    </svg>
                </span>
            </a>

            <!-- Contenido principal -->
            <div class="contenido-principal">

                <!-- Imagen polaroid -->
                <div class="polaroid" transition:name={`imagen-${proyecto.id}`}>
                    <img src={proyecto.data.imagen} alt={proyecto.data.titulo} class="polaroid-img" />
                    <div class="polaroid-pie"></div>
                </div>

                <!-- Info -->
                <div class="info">

                    <!-- Titulo -->
                    <div class="titulo-wrapper">
                        <h1 class="titulo" transition:name={`titulo-${proyecto.id}`}>{proyecto.data.titulo}</h1>
                        <svg class="subrayado" viewBox="0 0 200 20" fill="none" preserveAspectRatio="none">
                            <path d="M2 7 C50 4, 120 8, 175 5" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none"/>
                            <path d="M28 14 C70 18, 140 11, 198 16" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                        </svg>
                    </div>

                    <!-- Descripcion -->
                    <div class="descripcion-wrapper">
                        <div class="cinta"></div>
                        <div class="descripcion">
                            <Content />
                        </div>
                    </div>

                    <!-- Tecnologias -->
                    <div class="techs">
                        {proyecto.data.tecnologias.map(tech => (
                            <span class="tech-tag">{tech}</span>
                        ))}
                    </div>

                    <!-- Links -->
                    <div class="links">
                        <a href={proyecto.data.github} target="_blank" class="btn-gh">
                            <span>Ver en GitHub - </span>
                            <img src="/src/assets/githubdibujo.png" alt="GitHub" class="github-icon" />
                        </a>
                        {proyecto.data.demo && (
                            <a href={proyecto.data.demo} target="_blank" class="btn-demo">
                                Ver demo
                            </a>
                        )}
                    </div>

                </div>
            </div>

        </div>
    </section>
</Layout>

<style>
    /* Volver */
    .btn-volver {
        display: inline-flex;
        align-items: center;
        gap: 20px;
        text-decoration: none;
        width: fit-content;
        transform: rotate(-3deg);
    }

    .flecha-volver {
        width: 60px;
        height: 30px;
        transition: transform 0.3s cubic-bezier(.34,1.56,.64,1);
    }

    .btn-volver:hover .flecha-volver {
        transform: translateX(-8px);
    }

    .volver-texto {
        position: relative;
        font-family: 'Caveat', cursive;
        font-size: 2rem;
        font-weight: 700;
        color: #e63946;
        white-space: nowrap;
    }

    .circulo {
        position: absolute;
        top: -22px;
        left: -22px;
        width: calc(100% + 44px);
        height: calc(100% + 44px);
    }

    /* Layout principal */
    .contenido-principal {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    @media (min-width: 768px) {
        .contenido-principal {
            flex-direction: row;
            align-items: center;
            gap: 4rem;
        }
    }

    /* Polaroid */
    .polaroid {
        background: white;
        padding: 12px 12px 48px 12px;
        box-shadow: 4px 6px 20px rgba(0,0,0,0.15);
        transform: rotate(-2deg);
        flex-shrink: 0;
        width: 100%;
        max-width: 480px;
    }

    .polaroid-img {
        width: 100%;
        height: 300px;
        object-fit: cover;
        display: block;
    }

    .polaroid-pie {
        height: 36px;
    }

    /* Info */
    .info {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        flex: 1;
    }

    /* Titulo */
    .titulo-wrapper {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: fit-content;
        transform: rotate(-2deg);
    }

    .titulo {
        font-family: 'Caveat', cursive;
        font-size: 4rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
        line-height: 1;
    }

    .subrayado {
        width: 100%;
        height: 20px;
        margin-top: -4px;
    }

    /* Descripcion */
    .descripcion-wrapper {
        position: relative;
        background: #8BFB8B;
        padding: 2rem;
        transform: rotate(-1deg);
        box-shadow: 4px 6px 16px rgba(0,0,0,0.15);
    }

    .cinta {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%) rotate(-1deg);
        width: 70px;
        height: 26px;
        background: rgba(255,255,255,0.6);
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 1px 2px 6px rgba(0,0,0,0.1);
    }

    .descripcion {
        font-family: system-ui, sans-serif;
        font-size: 1rem;
        color: #1a1a1a;
        line-height: 1.8;
    }

    /* Techs */
    .techs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tech-tag {
        font-family: 'Fira Code', monospace;
        font-size: 0.75rem;
        background: #fdfd31;
        color: #1a1a1a;
        padding: 4px 12px;
        transform: rotate(-1deg);
        display: inline-block;
        box-shadow: 2px 2px 6px rgba(0,0,0,0.1);
    }

    .tech-tag:nth-child(even) {
        transform: rotate(1deg);
    }

    /* Botones */
    .links {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-gh {
        font-family: 'Caveat', cursive;
        font-size: 1.4rem;
        font-weight: 700;
        color: #1a1a1a;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: transform 0.2s ease;
    }

    .btn-gh:hover {
        transform: rotate(-2deg) scale(1.05);
    }

    .github-icon {
        width: 50px;
        height: 50px;
        object-fit: contain;
    }
</style>
