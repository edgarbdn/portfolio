---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en" transition:animate="slide">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Caveat:wght@400;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>Astro Basics</title>
	</head>
	<body>
		<Nav></Nav>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}

	html {
		min-height: 100%;
		background-color: #f7f7f7;
		background-image:
			linear-gradient(rgba(150, 150, 150, 0.2) 1px, transparent 1px),
			linear-gradient(90deg, rgba(150, 150, 150, 0.2) 1px, transparent 1px);
		background-size: 20px 20px;
	}

	body {
		background: transparent;
	}
</style>
