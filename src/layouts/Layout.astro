---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en" transition:animate="slide">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Caveat:wght@400;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>Edgar Moreno - Portfolio</title>
	</head>
	<body>
		<Nav></Nav>
		<slot />
		<Footer />

		<a href="https://www.linkedin.com/in/edgar-moreno-comas-032222352/" target="_blank" class="btn-linkedin">
			<img src="/src/assets/linkedin.png" alt="LinkedIn" />
		</a>

		<div class="cv-wrapper">
			<div class="cv-anotacion">
				<span class="cv-texto">Descarga mi CV</span>
				<svg class="cv-flecha" viewBox="0 0 50 60" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M25 5 C22 20, 20 35, 25 52" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none"/>
					<path d="M25 52 L17 42 M25 52 L33 42" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none"/>
				</svg>
			</div>
			<a href="/cv.pdf" download class="btn-cv">
				<img src="/src/assets/cv.png" alt="Descargar CV" />
			</a>
		</div>

		<div class="github-wrapper">
			<a href="https://github.com/edgarbdn" target="_blank" class="btn-github">
				<img src="/src/assets/github.png" alt="Mi Github" />
			</a>
			<div class="github-anotacion">
				<svg class="github-flecha" viewBox="0 0 50 60" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M25 52 C22 35, 20 20, 25 5" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none"/>
					<path d="M25 5 L17 15 M25 5 L33 15" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none"/>
				</svg>
				<span class="github-texto">Mi Github</span>
			</div>
		</div>

		<script>
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('visible');
					}
				});
			}, { threshold: 0.15 });

			document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

			document.addEventListener('astro:page-load', () => {
				window.scrollTo(0, 0);

				// Scroll a la seccion si hay hash en la URL
				if (window.location.hash) {
					const el = document.querySelector(window.location.hash);
					if (el) {
						setTimeout(() => {
							el.scrollIntoView({ behavior: 'smooth' });
						}, 100);
					}
				}

				document.querySelectorAll('.reveal').forEach(el => {
					if (!el.classList.contains('visible')) {
						observer.observe(el);
					}
				});
			});
		</script>
	</body>
</html>

<style>
	.btn-linkedin {
		position: fixed;
		right: -200px;
		top: 50%;
		transform: translateY(-50%);
		z-index: 100;
		width: 400px;
		height: auto;
		display: none;
		transition: right 0.4s ease;
	}

	.btn-linkedin:hover {
		right: 0;
	}

	.btn-linkedin img {
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	@media (min-width: 1420px) {
		.btn-linkedin {
			display: block;
		}
	}

	.cv-wrapper {
		position: fixed;
		right: 32px;
		top: 80px;
		z-index: 100;
		display: none;
		flex-direction: column;
		align-items: center;
		gap: 0;
	}

	@media (min-width: 1420px) {
		.cv-wrapper {
			display: flex;
		}
	}

	.cv-anotacion {
		display: flex;
		flex-direction: column;
		align-items: center;
		transform: rotate(-8deg);
	}

	.cv-texto {
		font-family: 'Caveat', cursive;
		font-size: 1.8rem;
		font-weight: 700;
		color: #1a1a1a;
		white-space: nowrap;
	}

	.cv-flecha {
		width: 40px;
		height: 50px;
		margin-top: -8px;
	}

	.btn-cv {
		width: 100px;
		height: 100px;
		background: transparent;
		display: block;
	}

	.btn-cv img,
	.btn-github img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.btn-cv img:hover,
	.btn-github img:hover {
		animation: wiggle 0.4s ease;
	}

	@keyframes wiggle {
		0%   { transform: rotate(0deg); }
		20%  { transform: rotate(-8deg); }
		40%  { transform: rotate(8deg); }
		60%  { transform: rotate(-5deg); }
		80%  { transform: rotate(5deg); }
		100% { transform: rotate(0deg); }
	}

	.github-wrapper {
		position: fixed;
		right: 32px;
		bottom: 40px;
		z-index: 100;
		display: none;
		flex-direction: column;
		align-items: center;
		gap: 0;
	}

	@media (min-width: 1420px) {
		.github-wrapper {
			display: flex;
		}
	}

	.btn-github {
		width: 100px;
		height: 100px;
	}

	.github-anotacion {
		display: flex;
		flex-direction: column;
		align-items: center;
		transform: rotate(8deg);
	}

	.github-flecha {
		width: 40px;
		height: 50px;
	}

	.github-texto {
		font-family: 'Caveat', cursive;
		font-size: 1.8rem;
		font-weight: 700;
		color: #1a1a1a;
		white-space: nowrap;
	}

	html {
		min-height: 100%;
		background-color: #f7f7f7;
		background-image:
			linear-gradient(rgba(150, 150, 150, 0.2) 1px, transparent 1px),
			linear-gradient(90deg, rgba(150, 150, 150, 0.2) 1px, transparent 1px);
		background-size: 20px 20px;
		scroll-padding-top: 120px;
	}

	body {
		margin: 0;
		width: 100%;
		background: transparent;
	}
</style>
