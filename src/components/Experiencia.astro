---
---

<section id="experiencia" class="w-full flex flex-col px-6 pb-32 pt-0">
    <div class="w-full max-w-5xl mx-auto">

        <!-- Título tachado -->
        <div class="reveal titulo-wrapper">
            <div class="tachado-wrapper">
                <span class="tachado">Trabajo</span>
                <svg class="linea-tipex" viewBox="0 0 160 20" fill="none">
                    <path d="M2 10 C40 8, 100 13, 155 9" stroke="white" stroke-width="12" stroke-linecap="round" fill="none"/>
                </svg>
                <svg class="linea-tachado" viewBox="0 0 160 30" fill="none">
                    <path d="M4 8 C40 12, 90 6, 148 10" stroke="#e63946" stroke-width="3" stroke-linecap="round" fill="none"/>
                    <path d="M8 16 C50 12, 100 18, 152 14" stroke="#e63946" stroke-width="2" stroke-linecap="round" fill="none"/>
                    <path d="M6 24 C45 20, 95 26, 150 22" stroke="#e63946" stroke-width="1.5" stroke-linecap="round" fill="none"/>
                </svg>
            </div>
            <span class="titulo">Experiencia</span>
        </div>

        <!-- Card -->
        <div class="reveal card-experiencia">
            <div class="borde-izq"></div>
            <div class="card-contenido">
                <div class="card-header">
                    <span class="empresa">PMC</span>
                    <span class="fechas">Abril 2025 · Octubre 2025 · 6 meses</span>
                </div>
                <p class="rol">Prácticas · Desarrollo Web Fullstack</p>
                <p class="descripcion">Desarrollo en proyectos reales de una empresa de soluciones tecnológicas para la oficina. Trabajé tanto en frontend como en backend y base de datos.</p>
                <div class="techs">
                    {['React', 'TypeScript', 'CSS', 'Tailwind', 'PHP', 'WordPress'].map(tech => (
                        <span class="tech-tag">{tech}</span>
                    ))}
                </div>
            </div>
        </div>

    </div>
</section>

<style>
    .titulo-wrapper {
        margin-bottom: 2rem;
        transform: rotate(-3deg);
        width: fit-content;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
    }

    .tachado-wrapper {
        position: relative;
        width: fit-content;
    }

    .tachado {
        font-family: 'Caveat', cursive;
        font-size: 3.5rem;
        font-weight: 700;
        color: #e63946;
        line-height: 1;
    }

    .linea-tipex {
        position: absolute;
        top: 30%;
        left: 0;
        width: 100%;
        height: 20px;
    }

    .linea-tachado {
        position: absolute;
        top: 40%;
        left: 0;
        width: 100%;
        height: 20px;
    }

    .titulo {
        font-family: 'Caveat', cursive;
        font-size: 4rem;
        font-weight: 700;
        color: #e63946;
        line-height: 1;
        white-space: nowrap;
    }

    .card-experiencia {
        display: flex;
        gap: 0;
        background: rgba(255,255,255,0.6);
        border-radius: 0 1rem 1rem 0;
        box-shadow: 4px 6px 20px rgba(0,0,0,0.08);
        overflow: hidden;
        max-width: 700px;
    }

    .borde-izq {
        width: 6px;
        background: #e63946;
        flex-shrink: 0;
    }

    .card-contenido {
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .card-header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 1rem;
    }

    .empresa {
        font-family: 'Caveat', cursive;
        font-size: 2.5rem;
        font-weight: 700;
        color: #1a1a1a;
        line-height: 1;
    }

    .fechas {
        font-family: 'Fira Code', monospace;
        font-size: 0.8rem;
        color: #888;
    }

    .rol {
        font-family: 'Fira Code', monospace;
        font-size: 0.95rem;
        font-weight: 600;
        color: #1a1a1a;
        margin: 0;
    }

    .descripcion {
        font-family: 'Fira Code', monospace;
        font-size: 0.85rem;
        color: #444;
        margin: 0;
        line-height: 1.7;
    }

    .techs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .tech-tag {
        font-family: 'Fira Code', monospace;
        font-size: 0.7rem;
        background: #1a1a1a;
        color: #f7f7f7;
        padding: 4px 10px;
        border-radius: 999px;
    }
</style>
