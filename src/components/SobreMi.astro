---
import FotoAnotada from './FotoAnotada.astro';
---

<section id="sobremi" class="reveal w-full min-h-screen flex justify-center items-center px-6 pt-16 pb-0">
    <div class="w-full max-w-5xl flex flex-col lg:flex-row items-center gap-12">

        <!-- Imagen con anotación -->
        <div class="imagen-wrapper">
            <FotoAnotada />
        </div>

        <!-- Texto -->
        <div class="texto flex flex-col gap-6 text-center md:text-left">
            <h2 class="nombre">Edgar Moreno</h2>
            <p class="frase">
                Soy Edgar (el de la derecha).<br/>
                <span class="highlight">Full Stack Developer.</span><br/>
                De los que aprenden haciendo y no paran hasta que funciona.
            </p>
            <p class="descripcion">
                Desarrollo tanto el frontend como el backend, con foco en construir productos reales, limpios y funcionales.
            </p>
        </div>

    </div>
</section>

<style>
    .boligrafo {
        position: absolute;
        top: 50px;
        left: 20px;
        width: 120px;
        height: auto;
        transform: rotate(-15deg);
        opacity: 0.85;
        pointer-events: none;
    }

    .imagen-wrapper {
        width: fit-content;
    }

    .texto {
        flex: 1;
        min-width: 0;
    }

    .nombre {
        font-family: 'Caveat', cursive;
        font-size: 3rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
        line-height: 1;
    }

    .frase {
        font-family: 'Fira Code', monospace;
        font-size: 1.2rem;
        font-weight: 400;
        color: #1a1a1a;
        margin: 0;
        line-height: 1.8;
    }

    .highlight {
        background: linear-gradient(transparent 60%, #00ff0070 60%);
    }

    .descripcion {
        font-family: 'Fira Code', monospace;
        font-size: 1rem;
        color: #1a1a1a;
        margin: 0;
        line-height: 1.8;
    }
</style>
