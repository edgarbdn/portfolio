---
import FotoAnotada from './FotoAnotada.astro';
---

<section id="sobremi" class="w-full min-h-screen flex justify-center items-center px-6 pt-16 pb-0">
    <div class="w-full max-w-5xl flex flex-col md:flex-row items-center gap-12">

        <!-- Imagen con anotación -->
        <FotoAnotada />

        <!-- Texto -->
        <div class="flex flex-col gap-6 text-center md:text-left">
            <h2 class="nombre">Edgar Moreno</h2>
            <p class="frase">
                Soy Edgar (el de la derecha).<br/>
                <span class="highlight">Full Stack Developer.</span><br/>
                De los que aprenden haciendo y no paran hasta que funciona.
            </p>
            <p class="descripcion">
                Desarrollo tanto el frontend como el backend, con foco en construir productos reales, limpios y funcionales.
            </p>
        </div>

    </div>
</section>

<style>
    .nombre {
        font-family: 'Caveat', cursive;
        font-size: 3rem;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
        line-height: 1;
    }

    .frase {
        font-family: 'Fira Code', monospace;
        font-size: 1.2rem;
        font-weight: 400;
        color: #1a1a1a;
        margin: 0;
        line-height: 1.8;
    }

    .highlight {
        background: linear-gradient(transparent 10%, #00ff0070 70%);
    }

    .descripcion {
        font-family: 'Fira Code', monospace;
        font-size: 1rem;
        color: #1a1a1a;
        margin: 0;
        line-height: 1.8;
    }
</style>
