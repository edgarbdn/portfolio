---
import { Menu } from 'lucide-astro';

const links = [
    { href: '/#sobremi', label: 'Sobre mí', rotate: '-3deg', translateY: '3px' },
    { href: '/#tecnologias', label: 'Mi stack', rotate: '2deg', translateY: '-5px' },
    { href: '/#proyectos', label: 'Mis proyectos', rotate: '-2deg', translateY: '7px' },
    { href: '/#experiencia', label: 'Experiencia', rotate: '3deg', translateY: '-3px' },
];

const colores = ['#8BFB8B', '#60a5fa', '#fdfd31', '#fca5a5'];
---

<header class="nav-header">
    <!-- Desktop -->
    <nav class="nav-desktop">
        {links.map((link, i) => (
            <a
                href={link.href}
                class="nav-nota"
                style={`--rot: ${link.rotate}; --ty: ${link.translateY}; background: ${colores[i]};`}
            >
                {link.label}
            </a>
        ))}
        <a href="/cv.pdf" download class="nav-nota nav-cv" style="transform: rotate(-1.5deg); background: #dbeafe;">
            Mi CV
        </a>
        <a href="https://github.com/edgarbdn" target="_blank" class="nav-nota nav-github" style="transform: rotate(1deg); background: #f3e8ff;">
            Mi Github
        </a>
        <a href="https://www.linkedin.com/in/edgar-moreno-comas-032222352/" target="_blank" class="nav-nota nav-linkedin" style="transform: rotate(-2deg); background: #bfdbfe;">
            LinkedIn
        </a>
    </nav>

    <!-- Móvil -->
    <div class="nav-movil">
        <button id="menu-btn" class="menu-btn">
            <Menu color="#1a1a1a" size={28} />
        </button>

        <div id="menu-desplegable" class="menu-desplegable cerrado">
            {links.map((link, i) => (
                <a
                    href={link.href}
                    class="nav-nota-movil"
                    style={`transform: rotate(${link.rotate}); background: ${colores[i]};`}
                >
                    {link.label}
                </a>
            ))}
            <a href="/cv.pdf" download class="nav-nota-movil" style="transform: rotate(-1.5deg); background: #dbeafe;">
                Mi CV
            </a>
            <a href="https://github.com/edgarbdn" target="_blank" class="nav-nota-movil" style="transform: rotate(1deg); background: #f3e8ff;">
                Mi Github
            </a>
            <a href="https://www.linkedin.com/in/edgar-moreno-comas-032222352/" target="_blank" class="nav-nota-movil" style="transform: rotate(-2deg); background: #bfdbfe;">
                LinkedIn
            </a>
        </div>
    </div>
</header>

<script>
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('menu-desplegable');

    btn?.addEventListener('click', () => {
        menu?.classList.toggle('cerrado');
    });

    menu?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => menu.classList.add('cerrado'));
    });
</script>

<style>
    .nav-header {
        position: fixed;
        top: 24px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        z-index: 50;
    }

    .nav-desktop {
        display: none;
    }

    .nav-movil {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    @media (min-width: 768px) {
        .nav-desktop {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-movil {
            display: none;
        }
    }

    @media (min-width: 1420px) {
        .nav-cv,
        .nav-github,
        .nav-linkedin {
            display: none;
        }
    }

    .nav-nota {
        font-family: 'Caveat', cursive;
        font-size: 1.3rem;
        font-weight: 700;
        color: #1a1a1a;
        text-decoration: none;
        padding: 8px 16px;
        box-shadow: 4px 6px 16px rgba(0,0,0,0.25);
        transition: transform 0.3s cubic-bezier(.34,1.56,.64,1), box-shadow 0.3s ease;
        position: relative;
        opacity: 0;
        animation: caerPapel 0.8s ease forwards;
    }

    .nav-nota:nth-child(1) { animation-delay: 0.1s; }
    .nav-nota:nth-child(2) { animation-delay: 0.2s; }
    .nav-nota:nth-child(3) { animation-delay: 0.3s; }
    .nav-nota:nth-child(4) { animation-delay: 0.4s; }
    .nav-nota:nth-child(5) { animation-delay: 0.5s; }
    .nav-nota:nth-child(6) { animation-delay: 0.6s; }
    .nav-nota:nth-child(7) { animation-delay: 0.7s; }

    @keyframes caerPapel {
        0% {
            opacity: 0;
            transform: translateY(-60px) rotate(-8deg);
        }
        70% {
            opacity: 1;
            transform: translateY(calc(var(--ty) + 4px)) rotate(var(--rot));
        }
        100% {
            opacity: 1;
            transform: translateY(var(--ty)) rotate(var(--rot));
        }
    }

    @media (min-width: 1420px) {
        .nav-nota {
            font-size: 1.6rem;
            padding: 12px 24px;
        }
    }

    .nav-nota::before {
        content: '';
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%) rotate(-1deg);
        width: 40px;
        height: 18px;
        background: rgba(255,255,255,0.55);
        border: 1px solid rgba(0,0,0,0.06);
    }

    .nav-nota:hover {
        transform: translateY(var(--ty)) rotate(var(--rot)) translateY(-6px) scale(1.03) !important;
        box-shadow: 6px 12px 24px rgba(0,0,0,0.25);
    }

    .menu-btn {
        background: white;
        border: none;
        padding: 10px;
        box-shadow: 3px 4px 12px rgba(0,0,0,0.15);
        cursor: pointer;
        border-radius: 4px;
    }

    .menu-desplegable {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }

    .menu-desplegable.cerrado {
        display: none;
    }

    .nav-nota-movil {
        font-family: 'Caveat', cursive;
        font-size: 1.3rem;
        font-weight: 700;
        color: #1a1a1a;
        text-decoration: none;
        padding: 8px 20px;
        box-shadow: 3px 4px 12px rgba(0,0,0,0.15);
        width: fit-content;
    }

    .nav-nota-movil:hover {
        transform: rotate(0deg) !important;
    }
</style>
