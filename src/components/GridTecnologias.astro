---
const tecnologias = [
    // Frontend
    { nombre: 'HTML', icono: '/assets/htmldibujo.png' },
    { nombre: 'CSS', icono: '/assets/cssdibujo.png' },
    { nombre: 'JavaScript', icono: '/assets/jsdibujo.png' },
    { nombre: 'TypeScript', icono: '/assets/tsdibujo (2).png' },
    { nombre: 'Tailwind', icono: '/assets/tailwinddibujo.png' },
    { nombre: 'React', icono: '/assets/reactdibujo.png' },
    { nombre: 'Next.js', icono: '/assets/nextjsdibujo.png' },
    // Backend
    { nombre: 'Node.js', icono: '/assets/nodejsdibujo.png' },
    { nombre: 'Express', icono: '/assets/expressdibujo.png' },
    { nombre: 'PHP', icono: '/assets/phpdibujo.png' },
    { nombre: 'Laravel', icono: '/assets/laraveldibujo.png' },
    { nombre: 'WordPress', icono: '/assets/wordpressdibujo.png' },
    // Base de datos
    { nombre: 'MongoDB', icono: '/assets/mongodibujo.png' },
    { nombre: 'PostgreSQL', icono: '/assets/postgresqldibujo.png' },
    { nombre: 'Prisma', icono: '/assets/prismadibujo.png' },
    // DevOps & Herramientas
    { nombre: 'Docker', icono: '/assets/dockerdibujo.png' },
    { nombre: 'Git', icono: '/assets/gitdibujo.png' },
    { nombre: 'GitHub', icono: '/assets/githubdibujo.png' },
];
---

<div class="grid">
    {tecnologias.map(tech => (
        <div class="tech-item">
            <img src={tech.icono} alt={tech.nombre} class="tech-icon" />
            <span class="tech-nombre">{tech.nombre}</span>
        </div>
    ))}
</div>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        margin-top: 0;
        justify-items: center;
    }

    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
    }

    .tech-item:hover .tech-icon {
        transform: rotate(-8deg) scale(1.1);
    }

    .tech-nombre {
        font-family: 'Caveat', cursive;
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a1a1a;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        white-space: nowrap;
    }

    .tech-item:hover .tech-nombre {
        opacity: 1;
        transform: translateY(0);
    }

    .tech-icon {
        width: 160px;
        height: 160px;
        object-fit: contain;
        transition: transform 0.3s cubic-bezier(.34,1.56,.64,1);
    }

    @media (max-width: 768px) {
        .grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
