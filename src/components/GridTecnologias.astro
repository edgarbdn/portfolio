---
import { Image } from 'astro:assets';

import htmldibujo from '../assets/htmldibujo.png';
import cssdibujo from '../assets/cssdibujo.png';
import jsdibujo from '../assets/jsdibujo.png';
import tsdibujo from '../assets/tsdibujo (2).png';
import tailwinddibujo from '../assets/tailwinddibujo.png';
import reactdibujo from '../assets/reactdibujo.png';
import nextjsdibujo from '../assets/nextjsdibujo.png';
import nodejsdibujo from '../assets/nodejsdibujo.png';
import expressdibujo from '../assets/expressdibujo.png';
import phpdibujo from '../assets/phpdibujo.png';
import laraveldibujo from '../assets/laraveldibujo.png';
import wordpressdibujo from '../assets/wordpressdibujo.png';
import mongodibujo from '../assets/mongodibujo.png';
import postgresqldibujo from '../assets/postgresqldibujo.png';
import prismadibujo from '../assets/prismadibujo.png';
import dockerdibujo from '../assets/dockerdibujo.png';
import gitdibujo from '../assets/gitdibujo.png';
import githubdibujo from '../assets/githubdibujo.png';

const tecnologias = [
    { nombre: 'HTML', icono: htmldibujo },
    { nombre: 'CSS', icono: cssdibujo },
    { nombre: 'JavaScript', icono: jsdibujo },
    { nombre: 'TypeScript', icono: tsdibujo },
    { nombre: 'Tailwind', icono: tailwinddibujo },
    { nombre: 'React', icono: reactdibujo },
    { nombre: 'Next.js', icono: nextjsdibujo },
    { nombre: 'Node.js', icono: nodejsdibujo },
    { nombre: 'Express', icono: expressdibujo },
    { nombre: 'PHP', icono: phpdibujo },
    { nombre: 'Laravel', icono: laraveldibujo },
    { nombre: 'WordPress', icono: wordpressdibujo },
    { nombre: 'MongoDB', icono: mongodibujo },
    { nombre: 'PostgreSQL', icono: postgresqldibujo },
    { nombre: 'Prisma', icono: prismadibujo },
    { nombre: 'Docker', icono: dockerdibujo },
    { nombre: 'Git', icono: gitdibujo },
    { nombre: 'GitHub', icono: githubdibujo },
];
---

<div class="grid">
    {tecnologias.map(tech => (
        <div class="tech-item">
            <Image src={tech.icono} alt={tech.nombre} class="tech-icon" />
            <span class="tech-nombre">{tech.nombre}</span>
        </div>
    ))}
</div>

<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
        margin-top: 0;
        justify-items: center;
    }

    .tech-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
    }

    .tech-item:hover .tech-icon {
        transform: rotate(-8deg) scale(1.1);
    }

    .tech-nombre {
        font-family: 'Caveat', cursive;
        font-size: 1.2rem;
        font-weight: 700;
        color: #1a1a1a;
        opacity: 0;
        transform: translateY(4px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        white-space: nowrap;
    }

    .tech-item:hover .tech-nombre {
        opacity: 1;
        transform: translateY(0);
    }

    .tech-icon {
        width: 160px;
        height: 160px;
        object-fit: contain;
        transition: transform 0.3s cubic-bezier(.34,1.56,.64,1);
    }

    @media (max-width: 768px) {
        .grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
