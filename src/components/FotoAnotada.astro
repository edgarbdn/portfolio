---
---

<div class="wrapper">
    <!-- Flecha + label encima de la cabeza -->
    <div class="annotation">
        <span class="label">developer</span>
        <svg class="arrow" viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 8 C30 20, 30 40, 12 55" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none"/>
            <path d="M12 55 L22 50 M12 55 L8 43" stroke="#1a1a1a" stroke-width="2" stroke-linecap="round" fill="none"/>
        </svg>
    </div>

    <img
        src="/src/assets/edgar.png"
        alt="Edgar y su perro"
        class="foto"
    />
</div>

<style>
    .wrapper {
        position: relative;
        width: 100%;
        max-width: 620px;
        flex-shrink: 0;
    }

    .foto {
        width: 100%;
        height: auto;
        object-fit: contain;
        border-radius: 1.5rem;
        display: block;
    }

    .annotation {
        position: absolute;
        top: 10px;
        left: 90%;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform: rotate(10deg);
    }

    .label {
        font-family: 'Caveat', cursive;
        font-size: 2rem;
        font-weight: 700;
        color: #1a1a1a;
        white-space: nowrap;
    }

    .arrow {
        width: 120px;
        height: 90px;
        margin-top: -8px;
    }
</style>
