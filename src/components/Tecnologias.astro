---
import TituloStack from './TituloStack.astro';
import GridTecnologias from './GridTecnologias.astro';
---

<section id="tecnologias" class="w-full flex flex-col px-6 pt-0 pb-32">
    <div class="w-full max-w-5xl mx-auto">
        <div class="reveal"><TituloStack /></div>
        <div class="reveal"><GridTecnologias /></div>
    </div>
</section>

<style>
    .boligrafo {
        position: absolute;
        top: 50%;
        left: 20px;
        transform: translateY(-50%) rotate(-15deg);
        width: 120px;
        height: auto;
        opacity: 0.85;
        pointer-events: none;
    }
</style>
